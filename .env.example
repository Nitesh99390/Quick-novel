# ---- required ---------------------------------------------------------------
# Create a bot with @BotFather and paste its token here
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- access -----------------------------------------------------------------
# Your Telegram user id(s) (send /id to the bot). ONLY these ids can use the bot.
ADMIN_IDS=
# true (default) = private bot, nobody except ADMIN_IDS can use it.
# false = ALLOWED_USERS (or everybody when empty) can use it too.
ADMIN_ONLY=true
ALLOWED_USERS=

# ---- sites ------------------------------------------------------------------
# Only these 9 sites are used (search, browse, links and auto scrape):
#   freewebnovel.com=FreeWebNovel  novelping.com=NovelBin  mtlnovel.me=MtlNovel
#   novelfull.com=NovelFull  royalroad.com=Royal Road  wuxiaworld.com=WuxiaWorld
#   wuxia.click=WuxiaClick  scribblehub.com=Scribblehub  readnovelfull.com=ReadNovelFull
# Empty = these 9. SITES=all = every working QuickNovel site.
SITES=

# ---- downloads --------------------------------------------------------------
# Books generated at the same time (all users)
MAX_CONCURRENT_DOWNLOADS=2
# Parallel chapter requests per book (sites may block you when this is high)
CHAPTER_PARALLELISM=3
# Max chapters per download for normal users (0 = unlimited, admins are never limited)
MAX_CHAPTERS=3000
# Files bigger than this are split into volumes. Telegram's Bot API limit is 50 MB
MAX_UPLOAD_MB=48
# Delete cached chapters older than N days (0 = never)
CACHE_DAYS=14

# ---- search -----------------------------------------------------------------
# Seconds to wait for each site
SEARCH_TIMEOUT=25
# Also use providers that are disabled in the QuickNovel app (mostly dead sites)
INCLUDE_DISABLED_PROVIDERS=false

# ---- auto scraper (24/7) ---------------------------------------------------
# The bot scrapes a COMPLETE novel, sends it to the dump channel and right after that
# starts the next novel - forever. Already sent novels are stored in data/sent.json and are
# NEVER scraped or sent again (checked by site+url and by title, across all sites).
AUTO_SEND=true
# Dump channel id (-100...). Add the bot as ADMIN of the channel. Empty = send to ADMIN_IDS
DUMP_CHANNEL_ID=
# Seconds between two novels (0 = immediately)
AUTO_DELAY_SEC=5
# Minutes to wait when no site has a new novel
AUTO_IDLE_MIN=15
# 0 = complete novel (default). Set e.g. 500 to cut long novels.
AUTO_MAX_CHAPTERS=0
# Skip novels with fewer / more chapters (0 = no upper limit)
AUTO_MIN_CHAPTERS=5
AUTO_SKIP_ABOVE=0
# Books with more failed chapters (percent) are not sent
AUTO_MAX_FAILED_PERCENT=10
# EPUB, TXT or HTML
AUTO_FORMAT=EPUB
AUTO_LANGUAGES=en
# Only some of the sites above (empty = all of them), e.g. NovelBin,FreeWebNovel
AUTO_SITES=
# How deep every popular/latest list of a site is searched
AUTO_MAX_PAGES=100

# ---- removed sites (only used with SITES=all) -------------------------------
# Sites that don't deliver novels are removed (src/main/resources/removed_providers.txt).
# Remove more sites / bring removed ones back, comma separated provider names:
# REMOVED_PROVIDERS=
# KEEP_PROVIDERS=

# ---- optional ---------------------------------------------------------------
# FlareSolverr solves Cloudflare challenges (strongly recommended, see docker-compose.yml)
# FLARESOLVERR_URL=http://flaresolverr:8191/v1
# Self-hosted Bot API server (lets you upload up to 2 GB, then raise MAX_UPLOAD_MB)
# TELEGRAM_API_URL=http://localhost:8081
DATA_DIR=data
LOG_LEVEL=info

# ---- required ---------------------------------------------------------------
# Create a bot with @BotFather and paste its token here
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- access -----------------------------------------------------------------
# Your Telegram user id(s) (send /id to the bot). Admins get /stats /broadcast /ban /testproviders
ADMIN_IDS=
# Comma separated user ids allowed to use the bot. Empty = everybody
ALLOWED_USERS=

# ---- downloads --------------------------------------------------------------
# Books generated at the same time (all users)
MAX_CONCURRENT_DOWNLOADS=2
# Parallel chapter requests per book (sites may block you when this is high)
CHAPTER_PARALLELISM=3
# Max chapters per download for normal users (0 = unlimited, admins are never limited)
MAX_CHAPTERS=3000
# Files bigger than this are split into volumes. Telegram's Bot API limit is 50 MB
MAX_UPLOAD_MB=48
# Delete cached chapters older than N days (0 = never)
CACHE_DAYS=14

# ---- search -----------------------------------------------------------------
# Seconds to wait for each site
SEARCH_TIMEOUT=25
# Also use providers that are disabled in the QuickNovel app (mostly dead sites)
INCLUDE_DISABLED_PROVIDERS=false

# ---- auto sender (finds new novels by itself and sends them) ----------------
# On by default. Sends to AUTO_CHAT_IDS, or to ADMIN_IDS when that is empty.
# Already sent novels are stored in data/sent.json and are NEVER scraped or sent again.
AUTO_SEND=true
# Your user id, a group id or a channel id (-100...). Add the bot as admin to channels.
AUTO_CHAT_IDS=
# Minutes between two runs, and novels per run
AUTO_INTERVAL_MIN=30
AUTO_NOVELS_PER_RUN=1
# Max chapters per novel (0 = all chapters; big novels take long), novels with fewer chapters are skipped
AUTO_MAX_CHAPTERS=500
AUTO_MIN_CHAPTERS=5
# EPUB, TXT or HTML
AUTO_FORMAT=EPUB
# Only sites of these languages (comma separated, default en)
AUTO_LANGUAGES=en
# Only these sites (empty = every working site), e.g. NovelBin,FreeWebNovel,LibRead
AUTO_SITES=
# Popular/latest pages searched per site for a novel that was not sent yet
AUTO_MAX_PAGES=10

# ---- sites ------------------------------------------------------------------
# Sites that don't deliver novels are removed (src/main/resources/removed_providers.txt).
# Remove more sites / bring removed ones back, comma separated provider names:
# REMOVED_PROVIDERS=
# KEEP_PROVIDERS=

# ---- optional ---------------------------------------------------------------
# FlareSolverr solves Cloudflare challenges (strongly recommended, see docker-compose.yml)
# FLARESOLVERR_URL=http://flaresolverr:8191/v1
# Self-hosted Bot API server (lets you upload up to 2 GB, then raise MAX_UPLOAD_MB)
# TELEGRAM_API_URL=http://localhost:8081
DATA_DIR=data
LOG_LEVEL=info
